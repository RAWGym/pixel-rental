# Скопируйте в .env.local (локально) или задайте в Vercel → Settings → Environment Variables.
# Без этих переменных приложение работает в демо-режиме: данные хранятся в браузере (localStorage).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# публичный ключ (anon / publishable) — его можно отдавать в браузер, доступ ограничивает RLS
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Только для демо: вход клиента по коду 1234 вместо настоящего SMS. В проде — false.
VITE_DEMO_OTP=true

# НЕ кладите сюда service_role / secret key — он никогда не должен попадать в браузерный код.
